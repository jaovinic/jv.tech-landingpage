<a href="#home" class="back-to-top" aria-label="Voltar ao topo">
  <i class="icon-arrow-up"></i>
</a>

<script>
  const button = document.querySelector<HTMLElement>(".back-to-top")!;

  function updateVisibility() {
    button.classList.toggle("show", window.scrollY >= 560);
  }

  window.addEventListener("scroll", updateVisibility, { passive: true });
  updateVisibility();
</script>

<style>
  .back-to-top {
    background: var(--accent);
    color: var(--on-accent);

    position: fixed;
    right: 1rem;
    bottom: 1rem;

    padding: 0.5rem;

    font-size: 1.5rem;
    line-height: 0;

    visibility: hidden;
    opacity: 0;

    transition: 0.3s;
    transform: translateY(100%);
  }

  .back-to-top.show {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }
</style>
