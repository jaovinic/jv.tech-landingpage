---
import { Image } from "astro:assets";
import heroImage from "../assets/images/hero.png";
---

<section class="section hero bg-grid" id="home">
  <div class="container grid">
    <div class="image" data-reveal>
      <Image
        src={heroImage}
        alt="Logotipo da JV Tech"
        widths={[448, 896]}
        sizes="(min-width: 1023px) 448px, calc(100vw - 3rem)"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="text" data-reveal>
      <span class="eyebrow">JV Tech · Consultoria de TI</span>
      <h1 class="title">Tecnologia sob medida para o <span>seu negócio</span></h1>
      <p>
        Sistema de gestão, software personalizado, suporte técnico e inovação.
        A <strong class="strong">JV Tech</strong> cuida da tecnologia para você
        cuidar da sua empresa, seja ela grande ou pequena.
      </p>
      <div class="actions">
        <a class="button" href="#contact">Agendar atendimento</a>
        <a class="button button--ghost" href="#services">Conhecer os serviços</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow: hidden;
  }

  .image {
    position: relative;
  }

  /* moldura deslocada para cima e para a direita */
  .image::before {
    content: "";
    position: absolute;
    top: -1rem;
    right: -1rem;
    bottom: 1rem;
    left: 1rem;
    border: 2px solid var(--principal);
    z-index: 0;
  }

  .image img {
    position: relative;
    display: block;
  }

  .text {
    text-align: center;
  }

  .text h1 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 10vw, 3.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  /* cursor piscando depois do título */
  .text h1 span {
    white-space: nowrap;
  }

  .text h1 span::after {
    content: "";
    display: inline-block;
    width: 0.5em;
    height: 0.12em;
    margin-left: 0.12em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text h1 span::after {
      animation: none;
    }
  }

  .text .eyebrow {
    justify-content: center;
  }

  .text p {
    margin-bottom: 2rem;
  }

  .actions .button {
    padding: 0 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
  }

  @media (min-width: 1023px) {
    .container {
      grid-auto-flow: column;
      align-items: center;
      justify-content: space-between;
    }

    .image {
      order: 1;
      width: 448px;
    }

    .text {
      order: 0;
      max-width: 30rem;
      text-align: left;
    }

    .text .eyebrow,
    .actions {
      justify-content: flex-start;
    }
  }
</style>
