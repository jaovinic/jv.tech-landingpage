---
import { Image } from "astro:assets";
import gipayTech from "../assets/images/clientes/gipay-tech.svg";
import gipay from "../assets/images/clientes/gipay.svg";
import gipayCred from "../assets/images/clientes/gipay-cred.svg";
import artMoveis from "../assets/images/clientes/art-moveis.png";
import projetec from "../assets/images/clientes/projetec.png";
import imperial from "../assets/images/clientes/imperial.png";
import potencial from "../assets/images/clientes/potencial.png";

const segments = [
  "Varejo",
  "Financeiro",
  "Consultoria rural",
  "Fábrica de móveis escolares",
];

const gipayGroup = [
  { logo: gipayTech, name: "GIPAY Tech", role: "Serviços de CaaS" },
  { logo: gipay, name: "GIPAY", role: "Banco digital" },
  { logo: gipayCred, name: "GIPAY Cred", role: "Empréstimos" },
];

const clients = [
  { logo: artMoveis, name: "Art Móveis", role: "Fábrica de móveis escolares" },
  { logo: projetec, name: "Projetec", role: "Consultoria rural" },
  { logo: imperial, name: "Imperial Magazine", role: "Varejo" },
  { logo: potencial, name: "Potencial Móveis", role: "Varejo" },
];
---

<section class="section" id="clients">
  <div class="container grid">
    <header data-reveal>
      <span class="eyebrow">03</span>
      <h2 class="title">Quem já confia na JV Tech</h2>
      <p class="subtitle">
        Do varejo ao financeiro, da consultoria rural à fábrica de móveis
        escolares: levamos tecnologia sob medida a negócios de segmentos
        diferentes.
      </p>
      <ul class="tags">
        {segments.map((segment) => <li>{segment}</li>)}
      </ul>
    </header>

    <div class="group" data-reveal>
      <h3 class="group-title">Grupo GIPAY</h3>
      <ul class="clients clients--group">
        {
          gipayGroup.map(({ logo, name, role }) => (
            <li class="client frame">
              <div class="logo-box">
                <Image src={logo} alt={name} widths={[240, 480]} sizes="240px" />
              </div>
              <p class="role">{role}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="clients clients--others">
      {
        clients.map(({ logo, name, role }) => (
          <li class="client frame" data-reveal>
            <div class="logo-box">
              <Image src={logo} alt={name} widths={[240, 480]} sizes="200px" />
            </div>
            <p class="role">{role}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  header .tags {
    justify-content: center;
  }

  header {
    text-align: center;
  }

  header .eyebrow {
    justify-content: center;
  }

  .group-title {
    margin-bottom: 1rem;
    font: 700 1rem/1.1 var(--font-sans);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .clients {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .clients--others {
    grid-template-columns: 1fr 1fr;
  }

  /* as logos dos clientes foram feitas para fundo claro: o cartão é branco nos dois temas */
  .client {
    --card: var(--branco);
    --line: #0b1b2b29;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1.5rem 1rem 1.25rem;
    text-align: center;
    color: var(--azul-noite);
  }

  .logo-box {
    width: 100%;
    height: 4.5rem;
    margin-bottom: 1rem;
  }

  .logo-box :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .role {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ardosia);
  }

  @media (min-width: 1023px) {
    header {
      max-width: 36rem;
      margin-left: auto;
      margin-right: auto;
    }

    .clients--group {
      grid-template-columns: repeat(3, 1fr);
    }

    .clients--others {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
