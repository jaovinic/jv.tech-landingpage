---
import { Image } from "astro:assets";
import logoClaro from "../assets/images/logo.svg";
import logoEscuro from "../assets/images/logo-reverse.svg";

interface Props {
  /**
   * `auto`: troca com o tema (logo em cores no claro, reversa no escuro).
   * `escuro`: sempre a versão reversa, para faixas azul-noite.
   */
  fundo?: "auto" | "escuro";
}

const { fundo = "auto" } = Astro.props;
const alt = "JV Tech, Consultoria de TI";
---

<a class:list={["logo", `logo--${fundo}`]} href="#home">
  {
    fundo === "auto" && (
      <Image class="claro" src={logoClaro} alt={alt} width={308} height={84} loading="eager" />
    )
  }
  <Image class="escuro" src={logoEscuro} alt={alt} width={308} height={84} loading="eager" />
</a>

<style is:global>
  /* mínimo da marca: 120 px de largura na tela */
  .logo {
    display: block;
    height: auto;
    width: 8.5rem;
  }

  .logo--escuro {
    width: 10rem;
  }

  /* `block` nas duas versões: a imagem `inline` ganha uma faixa de linha abaixo e o logo pularia ao trocar de tema */
  .logo img {
    display: block;
  }

  /* logo `auto`: a colorida aparece no tema claro, a reversa no escuro */
  .logo--auto .escuro {
    display: none;
  }

  :root[data-theme="dark"] .logo--auto .claro {
    display: none;
  }

  :root[data-theme="dark"] .logo--auto .escuro {
    display: block;
  }
</style>
