---
import { Image } from "astro:assets";
import logoClaro from "../assets/images/logo-claro.png";
import logoEscuro from "../assets/images/logo-escuro.png";

interface Props {
  /**
   * `auto`: troca com o tema (V3 no claro, principal no escuro).
   * `escuro`: sempre a versão principal, para faixas `marinho`.
   */
  fundo?: "auto" | "escuro";
}

const { fundo = "auto" } = Astro.props;
const alt = "JV Tech, Consultoria de TI";
---

<a class:list={["logo", `logo--${fundo}`]} href="#home">
  {
    fundo === "auto" && (
      <Image class="claro" src={logoClaro} alt={alt} widths={[160, 320]} sizes="160px" loading="eager" />
    )
  }
  <Image class="escuro" src={logoEscuro} alt={alt} widths={[160, 320]} sizes="160px" loading="eager" />
</a>

<style is:global>
  .logo {
    display: block;
    height: auto;
    width: 6rem;
  }

  .logo--escuro {
    width: 10rem;
  }

  /* logo `auto`: o V3 aparece no tema claro, o principal no escuro */
  .logo--auto .escuro {
    display: none;
  }

  :root[data-theme="dark"] .logo--auto .claro {
    display: none;
  }

  :root[data-theme="dark"] .logo--auto .escuro {
    display: block;
  }
</style>
